# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el .env real a git (ya debería estar en .gitignore).

# Cadena de conexión a PostgreSQL.
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL="postgresql://electrosac:cambia-esto@localhost:5432/electrosac"

# Puerto donde corre este servidor Express.
PORT=3001

# URL exacta del frontend (Vite) — se usa para CORS con credenciales.
# En producción, la URL real del dominio donde sirvas el frontend.
FRONTEND_URL="http://localhost:5173"

# Secretos para firmar los JWT. Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Usar 2 secretos DISTINTOS — si el de access token se filtra, el de
# refresh sigue siendo seguro (y viceversa).
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-distinto-y-aleatorio"

# Duración de los tokens.
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# "production" activa cookies Secure (solo se envían por HTTPS) — dejar
# en "development" mientras trabajas en localhost sin HTTPS.
NODE_ENV="development"

# Envío de correos (recuperar contraseña, contraseña temporal de usuario
# nuevo). Si dejas esto vacío, los correos se muestran en la consola del
# backend en vez de enviarse — útil mientras desarrollas sin credenciales
# reales todavía.
#
# Con Gmail: activa la verificación en 2 pasos en esa cuenta y genera una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# — SMTP_PASS es esa contraseña de 16 caracteres, NO tu contraseña normal.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS=""
SMTP_FROM="Activo360 <tu-correo@gmail.com>"

# Notificaciones push (Web Push — Android/Chrome y escritorio).
# Genera el par de claves UNA sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# y pega acá los 2 valores que te da (nunca los regeneres después de
# que algún celular ya se haya suscrito — las suscripciones viejas
# dejarían de funcionar).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@gmail.com"
